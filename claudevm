#!/usr/bin/env bash
#
# claudevm — manage per-project Lima sandbox VMs for Claude Code sessions.
#
# Setup (once):
#   ./install.sh
#
# Per project:
#   claudevm new myproject ~/code/myproject     # create config (doesn't boot yet)
#   claudevm up myproject                       # boot the VM
#   claudevm code myproject                     # open VS Code Remote-SSH into it
#   ...work...
#   claudevm down myproject                     # stop (keeps disk state)
#   claudevm rm myproject                       # stop + delete VM + delete config
#
set -euo pipefail

CLAUDEVM_HOME="${CLAUDEVM_HOME:-$HOME/.config/claudevm}"
TEMPLATE="$CLAUDEVM_HOME/claude-sandbox.yaml"
INSTANCES_DIR="${CLAUDEVM_INSTANCES:-$HOME/.local/var/claudevm/instances}"
# Source of ~/.gitconfig/~/.vimrc seeding in cmd_new -- normally your real
# home, but overridable (e.g. in tests) without affecting anything else.
DOTFILES_SOURCE="${CLAUDEVM_DOTFILES_SOURCE:-$HOME}"
# Overridable so tests can stand in for the device; install.sh reads the
# same variable.
KVM_DEVICE="${CLAUDEVM_KVM_DEVICE:-/dev/kvm}"

# Overridable so tests can fake the Linux host's RAM.
MEMINFO="${CLAUDEVM_MEMINFO:-/proc/meminfo}"

# Defaults for a new instance's size; see default_cpus and default_memory_gib.
CPU_FLOOR=4
CPU_CAP=8
MEMORY_FLOOR_GIB=4
MEMORY_CAP_GIB=8
DISK="${CLAUDEVM_DISK:-60}"      # GiB

usage() {
  cat <<EOF
Usage: claudevm <command> [args]

  new <name> <project-dir>   Create config for a new sandbox
  up <name>                   Boot (or resume) the sandbox VM
  down <name>                 Stop the VM (disk state is kept)
  rm <name>                   Stop, delete the VM, and delete its config
  ssh <name> [-- cmd]         Shell into the VM, or run cmd non-interactively
  code <name>                 Open VS Code (Remote-SSH) into /workspace on the VM
  ls [--json]                  List claudevm-managed instances and their status
EOF
}

clamp() {
  local value="$1" floor="$2" cap="$3"
  if [ "$value" -lt "$floor" ]; then
    value="$floor"
  elif [ "$value" -gt "$cap" ]; then
    value="$cap"
  fi
  echo "$value"
}

# Half the host's hardware threads, clamped to [CPU_FLOOR, CPU_CAP].
default_cpus() {
  local threads
  if [ "$(uname -s)" = "Darwin" ]; then
    threads="$(sysctl -n hw.logicalcpu)"
  else
    threads="$(nproc)"
  fi
  clamp $((threads / 2)) "$CPU_FLOOR" "$CPU_CAP"
}

# A quarter of the host's RAM in whole GiB, clamped to
# [MEMORY_FLOOR_GIB, MEMORY_CAP_GIB].
default_memory_gib() {
  local bytes
  if [ "$(uname -s)" = "Darwin" ]; then
    bytes="$(sysctl -n hw.memsize)"
  else
    bytes=$(($(awk '/^MemTotal:/ { print $2 }' "$MEMINFO") * 1024))
  fi
  clamp $((bytes / 4 / 1024 / 1024 / 1024)) "$MEMORY_FLOOR_GIB" "$MEMORY_CAP_GIB"
}

require_instance() {
  local name="$1"
  if [ ! -d "$INSTANCES_DIR/$name" ]; then
    echo "No config found for '$name'. Run: claudevm new $name <project-dir>" >&2
    exit 1
  fi
}

require_kvm() {
  # Without KVM, Lima on Linux silently falls back to TCG emulation, which
  # is too slow to use. macOS hosts use Apple's Virtualization.framework.
  [ "$(uname -s)" = "Linux" ] || return 0
  if [ ! -r "$KVM_DEVICE" ] || [ ! -w "$KVM_DEVICE" ]; then
    echo "$KVM_DEVICE is missing or not readable and writable by you; Lima needs KVM." >&2
    echo "Enable virtualization in your firmware settings, and if the device exists," >&2
    echo "run 'sudo usermod -aG kvm \$USER' and log in again." >&2
    exit 1
  fi
}

close_ssh_control() {
  # Lima opens its own SSH connection early in boot to run provisioning, and
  # (ControlPersist yes) keeps reusing it for later `claudevm ssh`/`limactl
  # shell`/VS Code sessions. /etc/environment is a file on the guest's own
  # disk, so at the moment that connection is opened it still holds
  # whatever the *previous* boot last wrote -- this boot's provisioning
  # hasn't run yet. That connection's session env is fixed at open time, so
  # it keeps serving that stale snapshot indefinitely. Force it closed right
  # after `up` finishes (provisioning is done by then), so the next
  # connection is guaranteed fresh instead of reusing the early one.
  local name="$1"
  # LIMA_HOME, when set, replaces $HOME/.lima outright rather than nesting
  # under it (confirmed via `limactl info`'s reported limaHome).
  local lima_home="${LIMA_HOME:-$HOME/.lima}"
  local ssh_cfg="$lima_home/$name/ssh.config"
  if [ -f "$ssh_cfg" ]; then
    ssh -O exit -F "$ssh_cfg" "lima-$name" >/dev/null 2>&1 || true
  fi
}

cmd_new() {
  local name="${1:?instance name required}"
  local project_dir="${2:?project directory required}"
  project_dir="$(cd "$project_dir" && pwd)"

  [ -f "$TEMPLATE" ] || { echo "Missing $TEMPLATE — copy claude-sandbox.yaml into $CLAUDEVM_HOME first." >&2; exit 1; }

  local cfg_dir="$INSTANCES_DIR/$name"
  mkdir -p "$cfg_dir"
  echo "$project_dir" > "$cfg_dir/project-dir"

  if [ -f "$DOTFILES_SOURCE/.gitconfig" ]; then
    cp "$DOTFILES_SOURCE/.gitconfig" "$cfg_dir/gitconfig"
  fi
  if [ -f "$DOTFILES_SOURCE/.vimrc" ]; then
    cp "$DOTFILES_SOURCE/.vimrc" "$cfg_dir/vimrc"
  fi

  echo "Created sandbox config: $name"
  echo "  Project dir:  $project_dir"
  echo "Next: claudevm up $name"
}

cmd_up() {
  local name="${1:?instance name required}"
  require_instance "$name"
  require_kvm
  local cfg_dir="$INSTANCES_DIR/$name"

  if limactl list -q 2>/dev/null | grep -qx "$name"; then
    # Instance already exists: its config (mounts, resources, etc.) was
    # fixed at creation time. Just resume it -- passing a template file or
    # --cpus/--memory/--disk here makes limactl think we're (re)creating
    # the instance, which fails with "instance already exists".
    limactl start "$name"
  else
    local project_dir
    project_dir="$(cat "$cfg_dir/project-dir")"

    # Render a per-instance config: the shared template plus an explicit
    # `mounts:` list, so the VM only ever sees the project dir and its own
    # config, never Lima's built-in default mounts (which include
    # the host's home directory). Built via plain file concatenation, not a
    # CLI `--mount` flag, since that flag's accepted syntax isn't consistent
    # across Lima versions and silently falling back to Lima's defaults is
    # exactly what exposed the host home directory before this fix.
    local rendered="$cfg_dir/.lima.yaml"
    cp "$TEMPLATE" "$rendered"
    {
      echo
      # QEMU on Linux defaults to 9p, which cv-012's benchmark found 4-5x
      # slower than virtiofs for small-file work. vz on macOS already
      # defaults to virtiofs.
      if [ "$(uname -s)" = "Linux" ]; then
        echo "mountType: virtiofs"
      fi
      echo "mounts:"
      echo "  - location: \"$project_dir\""
      echo "    mountPoint: \"/workspace\""
      echo "    writable: true"
      echo "  - location: \"$cfg_dir\""
      echo "    mountPoint: \"/mnt/claudevm-config\""
      echo "    writable: false"
    } >> "$rendered"

    local cpus="${CLAUDEVM_CPUS:-}" memory="${CLAUDEVM_MEMORY:-}"
    [ -n "$cpus" ] || cpus="$(default_cpus)"
    [ -n "$memory" ] || memory="$(default_memory_gib)"

    limactl start --name="$name" --tty=false \
      --cpus="$cpus" --memory="$memory" --disk="$DISK" \
      "$rendered"
  fi

  close_ssh_control "$name"

  echo
  echo "'$name' is up. Project mounted at /workspace."
  echo "  Shell:  claudevm ssh $name"
  echo "  VS Code: claudevm code $name"
}

cmd_down() {
  local name="${1:?instance name required}"
  limactl stop "$name"
}

cmd_rm() {
  local name="${1:?instance name required}"
  read -r -p "Delete VM and config for '$name'? This cannot be undone. [y/N] " ans
  case "$ans" in
    y|Y) ;;
    *) echo "Aborted."; exit 0 ;;
  esac
  limactl stop "$name" 2>/dev/null || true
  limactl delete "$name" 2>/dev/null || true
  rm -rf "${INSTANCES_DIR:?}/$name"
  echo "Removed '$name'."
}

cmd_ssh() {
  local name="${1:?instance name required}"
  shift
  # With no trailing args this is unchanged (interactive shell). With a
  # trailing `-- cmd`, it's forwarded straight to limactl shell, which
  # already treats `--` as "run this non-interactively instead" -- no
  # separate parsing needed here.
  limactl shell --workdir /workspace "$name" "$@"
}

cmd_code() {
  local name="${1:?instance name required}"
  if ! command -v code >/dev/null 2>&1; then
    echo "The 'code' CLI isn't on your PATH. In VS Code: Cmd+Shift+P -> 'Shell Command: Install code command in PATH'." >&2
    exit 1
  fi
  code --remote "ssh-remote+lima-$name" /workspace
}

cmd_ls() {
  local want_json=0
  if [ "${1:-}" = "--json" ]; then
    want_json=1
  fi

  # limactl list --format json emits one JSON object per line (NDJSON), not
  # a JSON array -- jq -s slurps it into one for lookups below.
  local limactl_json
  limactl_json="$(limactl list --format json 2>/dev/null | jq -s '.' 2>/dev/null)"
  if [ -z "$limactl_json" ] || [ "$limactl_json" = "null" ]; then
    limactl_json="[]"
  fi

  # Only claudevm-managed instances (those with a $INSTANCES_DIR config),
  # not every Lima VM on the machine. A name with no matching limactl entry
  # has been `claudevm new`'d but never booted -- synthesize "new" rather
  # than querying limactl for a name it's never heard of.
  local entries
  entries="$(
    for cfg_dir in "$INSTANCES_DIR"/*/; do
      [ -d "$cfg_dir" ] || continue
      local name dir status
      name="$(basename "$cfg_dir")"
      dir="$(cat "$cfg_dir/project-dir" 2>/dev/null)"
      status="$(echo "$limactl_json" | jq -r --arg name "$name" '.[] | select(.name == $name) | .status' 2>/dev/null)"
      if [ -z "$status" ]; then
        status="new"
      fi
      jq -n --arg name "$name" --arg status "$status" --arg dir "$dir" \
        '{name: $name, status: $status, projectDir: $dir}'
    done | jq -s '.'
  )"

  if [ "$want_json" -eq 1 ]; then
    echo "$entries"
    return
  fi

  if [ "$(echo "$entries" | jq 'length')" -eq 0 ]; then
    echo "No claudevm instances found. Run: claudevm new <name> <project-dir>"
    return
  fi

  printf "%-24s %-10s %s\n" "NAME" "STATUS" "PROJECT DIR"
  echo "$entries" | jq -r '.[] | [.name, .status, .projectDir] | @tsv' | \
    while IFS=$'\t' read -r name status dir; do
      printf "%-24s %-10s %s\n" "$name" "$status" "$dir"
    done
}

main() {
  local cmd="${1:-}"
  [ -n "$cmd" ] || { usage; exit 1; }
  shift || true
  case "$cmd" in
    new) cmd_new "$@" ;;
    up) cmd_up "$@" ;;
    down) cmd_down "$@" ;;
    rm) cmd_rm "$@" ;;
    ssh) cmd_ssh "$@" ;;
    code) cmd_code "$@" ;;
    ls) cmd_ls "$@" ;;
    -h|--help|help) usage ;;
    *) echo "Unknown command: $cmd" >&2; usage; exit 1 ;;
  esac
}

main "$@"
