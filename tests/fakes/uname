#!/usr/bin/env python3
"""Fake `uname`: answers only `-s` and `-m`, from FAKE_UNAME_S and
FAKE_UNAME_M, so tests choose the host platform. A missing variable is a
KeyError rather than a fallback to the real host's answer."""
import os
import sys

FLAGS = {"-s": "FAKE_UNAME_S", "-m": "FAKE_UNAME_M"}


def main(argv):
    if len(argv) != 1 or argv[0] not in FLAGS:
        print(f"fake uname: unsupported args {argv!r}", file=sys.stderr)
        return 1
    print(os.environ[FLAGS[argv[0]]])
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
